fetch("/api/counters/4", {
    method: "PUT",
    headers: {
        "Content-Type": "application/json"
    },
    body: JSON.stringify({
        nama: "Loket Pembayaran Test",
        layanan: "B"
    })
})
.then(response => response.json())
.then(data => console.log(data))
.catch(error => console.error(error));